# IMPORTANT — every VITE_-prefixed variable below (VITE_APP_API_TOKEN, VITE_API_BASE_URL,
# VITE_RC_KEY_IOS, VITE_RC_KEY_ANDROID, VITE_POSTHOG_KEY, VITE_POSTHOG_HOST) is read by Vite
# and baked directly into the built JS bundle at `vite build` time — there is no runtime
# fallback, and it is NOT read again later. Vercel's own build reads these from its project's
# Environment Variables settings, so that side is unaffected either way. But a NATIVE build
# (`npm run build && npx cap sync ios`/`android`) is built entirely on your own machine: it
# only sees what's in THIS .env file at the moment you run `npm run build`. A native build
# produced with one of these missing or stale ships that way permanently until rebuilt — most
# visibly, a missing/mismatched VITE_APP_API_TOKEN makes every /api/* call 401 on that build.
# See docs/deploy.md "Native build environment" for the full pre-build checklist.

# Google Gemini API key used by the analyze-plant* serverless functions.
GEMINI_API_KEY=
# Optional — Gemini model id to use as primary; defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=
# RevenueCat secret key used server-side to grant the promotional Pro Preview entitlement.
REVENUECAT_SECRET_API_KEY=

# Shared secret every /api/* request must send back as the X-App-Token header — see docs/deploy.md.
APP_API_TOKEN=
# Same value as APP_API_TOKEN, bundled into the client so it can send the header — see docs/deploy.md.
VITE_APP_API_TOKEN=

# Optional — absolute origin the native iOS/Android app should call for /api/* requests
# (e.g. https://my-jungle-app.vercel.app). A native WebView has no same-origin web page to
# relatively fetch "/api/..." against, so src/lib/apiAuth.ts's apiUrl() falls back to the
# production Vercel URL when this is unset. Only needed to point a native build at a
# different deployment (staging, a preview URL) instead of production.
VITE_API_BASE_URL=

# Discord webhook URL for delivering feedback submissions — configure this or the Resend pair below.
DISCORD_WEBHOOK_URL=
# Resend API key for delivering feedback submissions by email — configure this or the Discord webhook above.
RESEND_API_KEY=
# Destination email address for feedback submissions sent via Resend.
FEEDBACK_TO_EMAIL=
# From address for feedback emails sent via Resend.
FEEDBACK_FROM_EMAIL=myJungle <noreply@lumenapp.studio>

# RevenueCat public SDK key for iOS — never a "test_" key in a release build; see AGENTS.md.
VITE_RC_KEY_IOS=
# RevenueCat public SDK key for Android — never a "test_" key in a release build; see AGENTS.md.
VITE_RC_KEY_ANDROID=

# PostHog project API key — optional; leave blank to keep logEvent() console+localStorage-only (see docs/deploy.md).
VITE_POSTHOG_KEY=
# PostHog ingestion host — optional; defaults to the US PostHog Cloud host if unset (see docs/deploy.md).
VITE_POSTHOG_HOST=
