# Google Gemini API key used by the analyze-plant* serverless functions.
GEMINI_API_KEY=
# Optional — Gemini model id to use as primary; defaults to gemini-1.5-flash if unset.
GEMINI_MODEL=
# RevenueCat secret key used server-side to grant the promotional Pro Preview entitlement.
REVENUECAT_SECRET_API_KEY=

# Shared secret every /api/* request must send back as the X-App-Token header — see docs/deploy.md.
APP_API_TOKEN=
# Same value as APP_API_TOKEN, bundled into the client so it can send the header — see docs/deploy.md.
VITE_APP_API_TOKEN=

# Discord webhook URL for delivering feedback submissions — configure this or the Resend pair below.
DISCORD_WEBHOOK_URL=
# Resend API key for delivering feedback submissions by email — configure this or the Discord webhook above.
RESEND_API_KEY=
# Destination email address for feedback submissions sent via Resend.
FEEDBACK_TO_EMAIL=
# From address for feedback emails sent via Resend.
FEEDBACK_FROM_EMAIL=myJungle <onboarding@resend.dev>

# RevenueCat public SDK key for iOS — never a "test_" key in a release build; see AGENTS.md.
VITE_RC_KEY_IOS=
# RevenueCat public SDK key for Android — never a "test_" key in a release build; see AGENTS.md.
VITE_RC_KEY_ANDROID=

# PostHog project API key — optional; leave blank to keep logEvent() console+localStorage-only (see docs/deploy.md).
VITE_POSTHOG_KEY=
# PostHog ingestion host — optional; defaults to the US PostHog Cloud host if unset (see docs/deploy.md).
VITE_POSTHOG_HOST=
